# API Keys - copy to .env and fill in your keys
OPENAI_API_KEY=your-openai-key-here
GEMINI_API_KEY=your-gemini-key-here
OPENROUTER_API_KEY=your-openrouter-key-here
OMNIROUTE_API_KEY=your-omniroute-key-here
# ANTHROPIC_API_KEY=your-anthropic-key-here  # Not currently used in the main pipeline

# Default provider and cheapest still-served model (as of Sep 2026)
# See docs/agent.md Agent 2 for details on cheapest models.
DEFAULT_PROVIDER=omniroute
DEFAULT_MODEL=gpt-5-nano
FALLBACK_PROVIDER=openrouter

# Base URL cho từng provider (tuỳ chọn; nếu bỏ trống dùng mặc định của runner)
# - openai:   mặc định của SDK (api.openai.com)
# - openrouter: https://openrouter.ai/api/v1
# - omniroute: bắt buộc đặt OMNIROUTE_BASE_URL (router local, ví dụ local OpenAI-compatible)
# - gemini:   OpenAI-compatible endpoint của Google
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OMNIROUTE_BASE_URL=your-local-router-url

# Model riêng cho từng provider (tuỳ chọn; nếu bỏ trống dùng DEFAULT_MODEL)
# OMNIROUTE_MODEL=kiro/deepseek-3.2
# OPENAI_MODEL=gpt-5-nano
# GEMINI_MODEL=gemini-3.5-flash-lite
# OPENROUTER_MODEL=google/gemma-4-31b-it:free
